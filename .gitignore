# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# idea
/.idea
*.iml

# vscode
/.vscode

# claude code
.claude/

# project-specific
AGENTS.md
CLAUDE.md

# windows / editor noise
Thumbs.db
desktop.ini
*.bak
*~

# ad-hoc diff dumps
*.patch
